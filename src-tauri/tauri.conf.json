{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SketchUp Profile Switcher",
  "version": "1.0.8",
  "identifier": "com.ktplugin.suprofileswitcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SketchUp Profile Switcher",
        "width": 700,
        "height": 420,
        "minWidth": 680,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQzk4NzNEMTE2NEYxREQKUldUZDhXUVJQWWZKSUhBUjBQZ1hMcGlvRW9pdHNGRWpqd2U1bTNxeXBiY1NPL1hNT3c1dTErLzEK",
      "endpoints": ["https://github.com/phathua/su-profile-switcher/releases/latest/download/latest.json"]
    }
  }
}
