{
  "name": "su-profile-switcher",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:portable": "tauri build --no-bundle",
    "clean": "node scripts/clean.js",
    "clean:cargo": "cargo clean --manifest-path src-tauri/Cargo.toml",
    "clean:frontend": "node -e \"const fs = require('fs'); ['dist', 'node_modules/.vite'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\"",
    "bump": "node scripts/bump-version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "phosphor-svelte": "^3.1.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
